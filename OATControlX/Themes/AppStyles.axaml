<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Style Selector="Window">
		<Setter Property="Background" Value="{DynamicResource OatWindowBg}" />
		<Setter Property="Foreground" Value="{DynamicResource OatText}" />
		<Setter Property="FontSize" Value="13" />
	</Style>

	<Style Selector="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource OatText}" />
	</Style>

	<Style Selector="TextBlock.dim">
		<Setter Property="Foreground" Value="{DynamicResource OatTextDim}" />
	</Style>

	<Style Selector="TextBlock.h1">
		<Setter Property="FontSize" Value="15" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource OatAccent}" />
	</Style>

	<Style Selector="TextBlock.readout">
		<Setter Property="FontSize" Value="26" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="FontFamily" Value="monospace" />
		<Setter Property="Foreground" Value="{DynamicResource OatReadout}" />
	</Style>

	<Style Selector="TextBlock.mono">
		<Setter Property="FontFamily" Value="monospace" />
	</Style>

	<Style Selector="Border.panel">
		<Setter Property="Background" Value="{DynamicResource OatPanelBg}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OatPanelBorder}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="10" />
	</Style>

	<Style Selector="Button">
		<Setter Property="CornerRadius" Value="4" />
	</Style>

	<Style Selector="Button.slew">
		<Setter Property="Width" Value="62" />
		<Setter Property="Height" Value="62" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style Selector="Button.stop">
		<Setter Property="Background" Value="{DynamicResource OatStop}" />
		<Setter Property="Foreground" Value="{DynamicResource OatWindowBg}" />
		<Setter Property="FontWeight" Value="Bold" />
	</Style>

	<Style Selector="Button.stop:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource OatStop}" />
		<Setter Property="Foreground" Value="{DynamicResource OatWindowBg}" />
	</Style>

	<Style Selector="TabControl">
		<Setter Property="Background" Value="Transparent" />
	</Style>

	<Style Selector="TabItem">
		<Setter Property="FontSize" Value="14" />
		<Setter Property="Foreground" Value="{DynamicResource OatTextDim}" />
		<Setter Property="Padding" Value="10,4" />
		<Setter Property="MinHeight" Value="34" />
	</Style>

	<Style Selector="TabItem:selected">
		<Setter Property="Foreground" Value="{DynamicResource OatAccent}" />
	</Style>

	<Style Selector="TabItem /template/ Border#PART_SelectedPipe">
		<Setter Property="Background" Value="{DynamicResource OatAccent}" />
	</Style>

	<Style Selector="Ellipse.motor">
		<Setter Property="Width" Value="10" />
		<Setter Property="Height" Value="10" />
		<Setter Property="Fill" Value="{DynamicResource OatTextDim}" />
	</Style>

	<Style Selector="Ellipse.motor.active">
		<Setter Property="Fill" Value="{DynamicResource OatOk}" />
	</Style>

	<Style Selector="Separator">
		<Setter Property="Background" Value="{DynamicResource OatPanelBorder}" />
		<Setter Property="Height" Value="1" />
		<Setter Property="Margin" Value="0,6" />
	</Style>

</Styles>
