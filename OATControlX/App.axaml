<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OATControlX.App"
             RequestedThemeVariant="Dark">
	<Application.Styles>
		<FluentTheme />
		<StyleInclude Source="avares://OATControlX/Themes/AppStyles.axaml" />
	</Application.Styles>
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<!-- Palette slot 0: swapped at runtime by ThemeManager (Dark / Red) -->
				<ResourceInclude Source="avares://OATControlX/Themes/Dark.axaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
</Application>
